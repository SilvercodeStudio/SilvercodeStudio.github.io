# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file, and no spaces or tabs at the ends of
# lines (make lint checks that).
[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

[*.{html,css,js,json,yml,yaml}]
indent_style = space
indent_size = 2

[*.pl]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

# Kept as their authors or tools wrote them.
[*.svg]
trim_trailing_whitespace = false
